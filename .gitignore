# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# desktop packaging output
/dist/

# production
/build/*
!/build/icon.ico

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
tmp-logs/

# env files (can opt-in for committing if needed)
.env*

# local-only private notes and scratch docs
/local-notes/
/private-notes/
/docs-local/
/*.local.md
/*.private.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
